{
    "name": "agent-actions-await",
    "version": "0.1.0",
    "description": "Wait for GitHub PR checks and review feedback through MCP, with polling and optional webhooks",
    "type": "module",
    "license": "GPL-3.0-only",
    "engines": {
        "node": ">=20"
    },
    "bin": {
        "agent-actions-await": "./dist/bin/cli.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"src/**/*.{ts,js}\" \"bin/**/*.{ts,js}\" \"tests/**/*.{ts,js}\"",
        "format:check": "prettier --check \"src/**/*.{ts,js}\" \"bin/**/*.{ts,js}\" \"tests/**/*.{ts,js}\"",
        "prepack": "npm run build",
        "fake:github": "npm run build && node dist/bin/fake-github.js"
    },
    "keywords": [
        "github",
        "actions",
        "mcp",
        "pr",
        "cloudflared"
    ],
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@vitest/coverage-v8": "^5.0.5",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^9.1.2",
        "prettier": "^3.9.6",
        "typescript": "^5.6.0",
        "typescript-eslint": "^8.68.0",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.30.0",
        "zod": "^4.5.4"
    }
}
